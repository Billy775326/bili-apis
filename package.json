{
  "name": "bili-apis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Web API read client and evidence-based Bilibili interface catalog",
  "bin": {
    "bili-apis": "bin/bili-apis.mjs",
    "bili-web": "bin/bili-web.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "catalog": "node bin/bili-web.mjs",
    "docs:generate": "node scripts/build-pc-docs.mjs",
    "android:docs": "node scripts/build-docs.mjs && node scripts/build-discovery.mjs && node scripts/build-functions.mjs",
    "pc:capture": "node scripts/capture-pc-web.mjs",
    "pc:check": "node scripts/check-pc-web.mjs",
    "android:official:docs": "node scripts/build-official-android.mjs",
    "privacy:check": "node scripts/check-public-data.mjs"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "devDependencies": {
    "@babel/parser": "8.0.4"
  }
}
